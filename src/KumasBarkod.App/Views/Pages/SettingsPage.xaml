<Page x:Class="KumasBarkod.App.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Ayarlar"
      ScrollViewer.CanContentScroll="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PageMargin}">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Ayarlar" />

            <ui:InfoBar Margin="0,0,0,12"
                        IsOpen="{Binding MessageIsOpen, Mode=TwoWay}"
                        Severity="{Binding MessageSeverity}"
                        Title="{Binding MessageTitle}"
                        Message="{Binding MessageText}"
                        IsClosable="True" />

            <!-- ========== Google Sheets ========== -->
            <ui:Card Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="CloudArrowUp24" FontSize="22" Margin="0,0,10,0" />
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Google Sheets kopyası" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,14"
                               Text="Kayıtlar internet olunca Google Sheets'e kopyalanır (tek yönlü). İnternet olmadan uygulama aynen çalışır; kayıtlar birikir ve bağlantı gelince gönderilir." />

                    <Border Padding="14,10" Margin="0,0,0,16" CornerRadius="6"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <TextBlock FontSize="15" TextWrapping="Wrap">
                            <Run Text="Durum:" />
                            <Run Text="{Binding SyncStatusText, Mode=OneWay}">
                                <Run.Style>
                                    <Style TargetType="Run">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SyncNeedsAttention}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Run.Style>
                            </Run>
                            <Run Text="   ·   Bekleyen kayıt:" />
                            <Run Text="{Binding PendingCount, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </Border>

                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Apps Script web uygulaması adresi" />
                    <ui:TextBox x:Name="UrlBox" Text="{Binding SheetsUrl, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="https://script.google.com/macros/s/…/exec"
                                Icon="{ui:SymbolIcon Link24}" FontSize="15"
                                AutomationProperties.Name="Sheets adresi" />

                    <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,6" Text="Anahtar (API_KEY)" />
                    <ui:PasswordBox Password="{Binding SheetsKey, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    PlaceholderText="Apps Script'te tanımladığınız gizli anahtar"
                                    Icon="{ui:SymbolIcon Key24}" FontSize="15" RevealButtonEnabled="True"
                                    AutomationProperties.Name="Sheets anahtarı" />

                    <WrapPanel Margin="0,16,0,0">
                        <ui:Button Margin="0,0,8,8" MinHeight="40" Appearance="Secondary"
                                   Icon="{ui:SymbolIcon PlugConnected24}" Content="Bağlantıyı test et"
                                   Command="{Binding TestConnectionCommand}" />
                        <ui:Button Margin="0,0,8,8" MinHeight="40" Appearance="Primary"
                                   Icon="{ui:SymbolIcon Save24}" Content="Kaydet"
                                   Command="{Binding SaveSheetsCommand}" />
                        <ui:Button Margin="0,0,8,8" MinHeight="40" Appearance="Secondary"
                                   Icon="{ui:SymbolIcon ArrowSync24}" Content="Şimdi gönder"
                                   Command="{Binding SendNowCommand}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource FieldHintStyle}" TextWrapping="Wrap"
                               Text="Kurulum adımları: proje klasöründe tools\sheets\KURULUM.md. Adres ve anahtar yalnızca bu bilgisayarda saklanır." />
                </StackPanel>
            </ui:Card>

            <!-- ========== Kesim ========== -->
            <ui:Card Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Ruler24" FontSize="22" Margin="0,0,10,0" />
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Kesim" />
                    </DockPanel>

                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Metre üst sınırı" />
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBox Width="160" FontSize="15" Text="{Binding MaxLengthText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="8,0,16,0" VerticalAlignment="Center" FontSize="15" Text="m" />
                        <ui:Button MinHeight="36" Appearance="Secondary" Content="Kaydet" Command="{Binding SaveMaxLengthCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource FieldHintStyle}" TextWrapping="Wrap"
                               Text="Bundan uzun kesim girilemez. Yanlış yazımı (25,50 yerine 2550) yakalamak için gerçekçi bir değer seçin." />

                    <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,4" Text="İstasyon kodu" />
                    <TextBlock FontSize="18" FontWeight="SemiBold" FontFamily="Consolas" Text="{Binding StationCode}" />
                    <TextBlock Style="{StaticResource FieldHintStyle}" TextWrapping="Wrap"
                               Text="Kesim ID'lerinin başındaki kod. İkinci istasyon kurulurken farklı kod verilir; kurulumda ayarlanır." />
                </StackPanel>
            </ui:Card>

            <!-- ========== Yedekler ========== -->
            <ui:Card Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="DatabaseArrowDown20" FontSize="22" Margin="0,0,10,0" />
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Yerel yedekler" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,12"
                               Text="Her gün otomatik yedek alınır, son 30 gün saklanır. Yedek aynı diskte durur: bozulan dosyaya ve yanlış işleme karşıdır. Disk arızasına karşı koruma Google Sheets kopyasıdır." />
                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding LastBackupText}" Margin="0,0,0,12" />
                    <WrapPanel>
                        <ui:Button Margin="0,0,8,8" MinHeight="40" Appearance="Secondary"
                                   Icon="{ui:SymbolIcon Save24}" Content="Şimdi yedekle"
                                   Command="{Binding BackupNowCommand}" />
                        <ui:Button Margin="0,0,8,8" MinHeight="40" Appearance="Secondary"
                                   Icon="{ui:SymbolIcon FolderOpen24}" Content="Yedek klasörünü aç"
                                   Command="{Binding OpenBackupFolderCommand}" />
                    </WrapPanel>
                </StackPanel>
            </ui:Card>

            <!-- ========== Geri kurma ========== -->
            <ui:Card Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="ArrowDownload24" FontSize="22" Margin="0,0,10,0" />
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Sheets'ten geri kur" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,12"
                               Text="Disk arızası veya yeni bilgisayar: veritabanını Google Sheets kopyasından kurar. İptal ve baskı bilgisi korunur. Gönderilmemiş son kayıtların ID'leri tekrar kullanılmasın diye sıra numarası 1000 ileri atlatılır." />
                    <TextBlock FontSize="15" Text="{Binding RestoreHint}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <ui:Button HorizontalAlignment="Left" MinHeight="40" Appearance="Secondary"
                               Icon="{ui:SymbolIcon ArrowDownload24}" Content="Sheets'ten geri kur…"
                               Command="{Binding BeginRestoreCommand}" />

                    <Border Margin="0,12,0,0" Padding="16" CornerRadius="6" BorderThickness="1"
                            BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                            Visibility="{Binding IsRestoreConfirmOpen, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock FontSize="15" TextWrapping="Wrap"
                                       Text="Sheets'teki tüm kayıtlar bu bilgisayara kurulacak. Bu sırada uygulamada kayıt açmayın. Devam edilsin mi?" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <ui:Button MinHeight="40" Appearance="Primary" Content="Evet, geri kur"
                                           Command="{Binding ConfirmRestoreCommand}" />
                                <ui:Button Margin="8,0,0,0" MinHeight="40" Appearance="Secondary" Content="Vazgeç"
                                           Command="{Binding CancelRestoreCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                Visibility="{Binding IsRestoring, Converter={StaticResource BoolToVisibility}}">
                        <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="0,0,10,0" />
                        <TextBlock VerticalAlignment="Center" FontSize="15" Text="{Binding RestoreProgress}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- ========== Bilgi ========== -->
            <ui:Card Padding="24">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Folder24" FontSize="22" Margin="0,0,10,0" />
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Dosyalar" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource DetailLabelStyle}" Text="Veritabanı" />
                    <TextBox IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="Consolas"
                             Text="{Binding DatabasePath, Mode=OneWay}" Margin="0,0,0,10" />
                    <TextBlock Style="{StaticResource DetailLabelStyle}" Text="Test yazıcısı etiket klasörü" />
                    <TextBox IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="Consolas"
                             Text="{Binding LabelDirectory, Mode=OneWay}" Margin="0,0,0,10" />
                    <TextBlock Style="{StaticResource DetailLabelStyle}" Text="Hata günlüğü" />
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Content="Aç"
                                   Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenLogFolderCommand}" />
                        <TextBox IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="Consolas"
                                 VerticalAlignment="Center" Text="{Binding LogDirectory, Mode=OneWay}" />
                    </DockPanel>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
