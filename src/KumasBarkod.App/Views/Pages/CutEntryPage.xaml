<Page x:Class="KumasBarkod.App.Views.Pages.CutEntryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Kesim Girişi"
      ScrollViewer.CanContentScroll="False">
    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" MinWidth="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="4*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="3" Style="{StaticResource PageTitleStyle}" Text="Kesim Girişi" />

        <!-- ========== Giriş ========== -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ui:Card Padding="24">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Lot" />
                        <ui:TextBox x:Name="LotBox"
                                    Text="{Binding LotText, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Lot yazın veya ↑ ↓ ile son lotlardan seçin"
                                    FontSize="24"
                                    MinHeight="56"
                                    ClearButtonEnabled="False"
                                    PreviewKeyDown="LotBox_PreviewKeyDown"
                                    AutomationProperties.Name="Lot" />

                        <!-- Son lotlar: her zaman görünür; ↑ ↓ ile lot kutusundan gezilir, tıklanabilir. -->
                        <ListBox x:Name="RecentLotsList"
                                 Margin="0,8,0,0"
                                 ItemsSource="{Binding RecentLots}"
                                 SelectedIndex="{Binding RecentLotIndex, Mode=TwoWay}"
                                 Focusable="False"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseLeftButtonUp="RecentLotsList_PreviewMouseLeftButtonUp">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Margin" Value="0,0,6,6" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Chip" Padding="12,5" CornerRadius="14" BorderThickness="1"
                                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                                    <TextBlock x:Name="ChipText" FontSize="15" Text="{Binding}"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                        <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                        <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,6" Text="Uzunluk (cm)" />
                        <ui:TextBox x:Name="LengthBox"
                                    Text="{Binding LengthText, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="ör. 2550"
                                    FontSize="32"
                                    MinHeight="64"
                                    ClearButtonEnabled="False"
                                    AutomationProperties.Name="Uzunluk (cm)">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SaveCommand}" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                        <TextBlock Text="{Binding LengthHint}" FontSize="16" Margin="2,6,0,0" MinHeight="22">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource FieldHintStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LengthHintIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ui:Button Margin="0,20,0,0"
                                   HorizontalAlignment="Stretch"
                                   MinHeight="56"
                                   FontSize="20"
                                   Appearance="Primary"
                                   Command="{Binding SaveCommand}"
                                   Content="Kaydet ve etiket bas  (Enter)"
                                   Icon="{ui:SymbolIcon Save24}" />

                        <!-- Tek tuşla sıradaki parça: aynı lot ve uzunluk, yeni ID. -->
                        <ui:Button Margin="0,10,0,0"
                                   HorizontalAlignment="Stretch"
                                   MinHeight="60"
                                   Appearance="Success"
                                   Focusable="False"
                                   Command="{Binding NextPieceCommand}"
                                   AutomationProperties.Name="Sıradaki parça"
                                   Icon="{ui:SymbolIcon ArrowRight24}">
                            <StackPanel>
                                <TextBlock FontSize="20" Text="Sıradaki parça  (F5)" HorizontalAlignment="Center" />
                                <TextBlock FontSize="14" Text="{Binding NextPieceHint}" HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </ui:Card>

                <ui:InfoBar Margin="0,16,0,0"
                            IsOpen="{Binding ResultIsOpen, Mode=TwoWay}"
                            Severity="{Binding ResultSeverity}"
                            Title="{Binding ResultTitle}"
                            Message="{Binding ResultMessage}"
                            IsClosable="False"
                            FontSize="18" />

                <TextBlock Margin="4,16,0,0" Style="{StaticResource FieldHintStyle}" TextWrapping="Wrap">
                    <Run FontWeight="SemiBold" Text="Kısayollar:" />
                    <Run Text="Enter → sonraki alan / kaydet   ·   F2 → lot   ·   ↑ ↓ (lotta) → son lotlar   ·   F5 → sıradaki parça   ·   F6 → bozulan etiketi yeniden bas   ·   Esc → uzunluğu temizle" />
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <!-- ========== Son etiket (önizleme) ========== -->
        <ui:Card Grid.Row="0" Padding="16,12" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <ui:Button DockPanel.Dock="Right" Padding="12,4" Appearance="Secondary" Focusable="False"
                               Icon="{ui:SymbolIcon BarcodeScanner24}" Content="Okut (gösterim)"
                               ToolTip="Okuyucunun yapacağını taklit eder: bu etiketin kaydı okutma ekranında açılır"
                               Command="{Binding DemoScanCommand}" />
                    <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="Son etiket" />
                </DockPanel>
                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6" Padding="14">
                    <controls:LabelPreview xmlns:controls="clr-namespace:KumasBarkod.App.Controls"
                                           Label="{Binding LastLabel}" MaxHeight="190" HorizontalAlignment="Center" />
                </Border>
                <TextBlock Margin="2,6,0,0" Style="{StaticResource FieldHintStyle}" TextWrapping="Wrap"
                           Text="Gerçek görünüm (50 × 30 mm). Barkod ekrandan da okunabilir." />

                <!-- Aynı ID ile baskı bilerek iki adımlıdır: yeni parça için kolay yol F5 olmalı. -->
                <ui:Button Margin="0,8,0,0" HorizontalAlignment="Stretch" MinHeight="36"
                           Appearance="Secondary" Focusable="False"
                           Command="{Binding BeginReprintCommand}"
                           Visibility="{Binding HasLastCut, Converter={StaticResource BoolToVisibility}}"
                           Icon="{ui:SymbolIcon Print24}" Content="Bozulan etiketi yeniden bas  (F6)" />
                <Border x:Name="ReprintPanel" Margin="0,8,0,0" Padding="12" CornerRadius="6" BorderThickness="1"
                        Focusable="True" FocusVisualStyle="{x:Null}"
                        BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                        AutomationProperties.Name="Bozulan etiket onayı"
                        LostKeyboardFocus="ReprintPanel_LostKeyboardFocus"
                        Visibility="{Binding IsReprintPanelOpen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock FontSize="15" TextWrapping="Wrap">
                            <Run Text="{Binding LastCutId, Mode=OneWay}" FontFamily="Consolas" FontWeight="SemiBold" />
                            <Run Text="aynı ID ile tekrar basılacak. Yalnızca etiket bozulduysa kullanın. Yeni parça için F5." />
                        </TextBlock>
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <ui:Button MinHeight="36" Appearance="Primary" Focusable="False"
                                       Command="{Binding ConfirmReprintCommand}" Content="Aynı ID ile bas  (Enter)" />
                            <ui:Button Margin="8,0,0,0" MinHeight="36" Appearance="Secondary" Focusable="False"
                                       Command="{Binding CancelReprintCommand}" Content="Vazgeç  (Esc)" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ui:Card>

        <!-- ========== Son kayıtlar ========== -->
        <ui:Card Grid.Row="1" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Margin="20,16,20,8" FontSize="18" FontWeight="SemiBold" Text="Son kayıtlar" />
                <Grid DockPanel.Dock="Top" Margin="20,0,20,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource ColumnHeaderStyle}" Text="ID" />
                    <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeaderStyle}" Text="Lot" />
                    <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeaderStyle}" Text="Metre" TextAlignment="Right" />
                    <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeaderStyle}" Text="Saat" TextAlignment="Right" />
                    <TextBlock Grid.Column="4" Style="{StaticResource ColumnHeaderStyle}" Text="Etiket" TextAlignment="Right" />
                </Grid>
                <TextBlock DockPanel.Dock="Top" Margin="20,8" Style="{StaticResource FieldHintStyle}" Text="Henüz kayıt yok.">
                    <TextBlock.Visibility>
                        <Binding Path="RecentCuts.Count" Converter="{StaticResource ZeroToVisibleConverter}" />
                    </TextBlock.Visibility>
                </TextBlock>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl ItemsSource="{Binding RecentCuts}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="20,8" BorderThickness="0,1,0,0"
                                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontFamily="Consolas" FontSize="15" FontWeight="SemiBold" Text="{Binding CutId}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsVoided}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" FontSize="15" Text="{Binding LotCode}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" FontSize="15" Text="{Binding Meters}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="3" FontSize="15" Text="{Binding Time}" TextAlignment="Right"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <!-- Basılmamış etiket uyarı simgesiyle öne çıkar -->
                                        <ui:SymbolIcon Grid.Column="4" HorizontalAlignment="Right" FontSize="16">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Symbol" Value="Checkmark16" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    <Setter Property="ToolTip" Value="{Binding PrintCount, StringFormat='{}{0} kez basıldı'}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PrintCount}" Value="0">
                                                            <Setter Property="Symbol" Value="Warning16" />
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                            <Setter Property="ToolTip" Value="Etiket basılmadı" />
                                                        </DataTrigger>
                                                        <!-- İptal, baskı durumundan önce gelir (sonraki tetikleyici kazanır) -->
                                                        <DataTrigger Binding="{Binding IsVoided}" Value="True">
                                                            <Setter Property="Symbol" Value="DismissCircle16" />
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                            <Setter Property="ToolTip" Value="İptal edildi" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </ui:Card>
        </Grid>
    </Grid>
</Page>
