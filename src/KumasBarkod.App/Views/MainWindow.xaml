<ui:FluentWindow x:Class="KumasBarkod.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:KumasBarkod.App.Views.Pages"
                 xmlns:vm="clr-namespace:KumasBarkod.App.ViewModels"
                 Title="Kumaş Barkod"
                 Icon="pack://application:,,,/Assets/app.ico"
                 Width="1200" Height="720" MinWidth="960" MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 WindowState="Maximized"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Kumaş Kalite Kontrol ve Barkod Takip" />

        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Row="1"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="False"
                           OpenPaneLength="230">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="NavCutEntry" Content="Kesim Girişi" TargetPageType="{x:Type pages:CutEntryPage}" ToolTip="Ctrl+1">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Cut24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="NavScan" Content="Okutma" TargetPageType="{x:Type pages:ScanPage}" ToolTip="Ctrl+2">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="BarcodeScanner24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="NavHistory" Content="Geçmiş" TargetPageType="{x:Type pages:HistoryPage}" ToolTip="Ctrl+3">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="History24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="NavShipment" Content="Sevkiyat" TargetPageType="{x:Type pages:ShipmentPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="VehicleTruck24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="NavStock" Content="Depo Stoğu" TargetPageType="{x:Type pages:StockPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="BuildingRetail24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="NavLots" Content="Lotlar" TargetPageType="{x:Type pages:LotsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Tag24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="NavPersonnel" Content="Personel" TargetPageType="{x:Type pages:PersonnelPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="People24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Ayarlar" TargetPageType="{x:Type pages:SettingsPage}" ToolTip="Ctrl+4">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!-- Durum çubuğu: istasyon ve bekleyen gönderim her ekranda görünür. -->
        <Border Grid.Row="2"
                Padding="16,6"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Margin="0,0,20,0"
                           Visibility="{Binding IsQcRole, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                    <Run Text="Bu bilgisayar:" />
                    <Run Text="{Binding RoleText, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
                <ui:SymbolIcon Symbol="Desktop24" Margin="0,0,6,0" Visibility="{Binding IsQcRole, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock VerticalAlignment="Center" Visibility="{Binding IsQcRole, Converter={StaticResource BoolToVisibility}}">
                    <Run Text="İstasyon:" />
                    <Run Text="{Binding StationCode, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
                <ui:SymbolIcon Symbol="CloudArrowUp24" Margin="20,0,6,0" Visibility="{Binding IsQcRole, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock VerticalAlignment="Center" ToolTip="Google Sheets'e henüz gönderilmemiş kayıt" Visibility="{Binding IsQcRole, Converter={StaticResource BoolToVisibility}}">
                    <Run Text="Sheets bekleyen:" />
                    <Run Text="{Binding PendingSyncCount, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="300"
                           TextTrimming="CharacterEllipsis" Visibility="{Binding IsQcRole, Converter={StaticResource BoolToVisibility}}"
                           Text="{Binding SyncStatusText}" ToolTip="{Binding SyncStatusText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SyncNeedsAttention}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ui:SymbolIcon Symbol="BuildingRetail24" Margin="20,0,6,0" Visibility="{Binding IsQcRole, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock VerticalAlignment="Center" ToolTip="Depo sunucusuna henüz gönderilmemiş kayıt" Visibility="{Binding IsQcRole, Converter={StaticResource BoolToVisibility}}">
                    <Run Text="Depo bekleyen:" />
                    <Run Text="{Binding PendingServerCount, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="280"
                           TextTrimming="CharacterEllipsis" Visibility="{Binding IsQcRole, Converter={StaticResource BoolToVisibility}}"
                           Text="{Binding ServerStatusText}" ToolTip="{Binding ServerStatusText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ServerNeedsAttention}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ui:SymbolIcon Symbol="Print24" Margin="20,0,6,0" Visibility="{Binding IsQcRole, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock VerticalAlignment="Center" Visibility="{Binding IsQcRole, Converter={StaticResource BoolToVisibility}}">
                    <Run Text="Yazıcı:" />
                    <Run Text="{Binding PrinterName, Mode=OneWay}">
                        <Run.Style>
                            <Style TargetType="Run">
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PrinterIsPhysical}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Run.Style>
                    </Run>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
