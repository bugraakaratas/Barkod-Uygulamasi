<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\KumasBarkod.Core\KumasBarkod.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Uygulama bilgisi (Ayarlar'da, dosya özelliklerinde ve kurulumda görünür) -->
    <AssemblyName>KumasBarkod</AssemblyName>
    <RootNamespace>KumasBarkod.App</RootNamespace>
    <Version>1.0.1</Version>
    <Product>Kumaş Barkod</Product>
    <AssemblyTitle>Kumaş Kalite Kontrol ve Barkod Takip</AssemblyTitle>
    <Description>Kumaş kesim kaydı, barkod etiketi ve okutma</Description>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Yayın: fabrika bilgisayarına .NET kurmak gerekmez (uygulama kendi .NET'ini taşır). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>tr;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
